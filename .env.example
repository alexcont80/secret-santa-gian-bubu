# Copiare in un file privato o impostare come Secret in Google AI Studio
SANTA_DB=firestore
SANTA_FIRESTORE_PROJECT=
SANTA_FIRESTORE_DATABASE=
SANTA_GUEST_PASSWORD=
SANTA_ADMIN_NAME=
SANTA_ADMIN_PASSWORD=
SANTA_SESSION_SECRET=
# Lasciare vuoto per le foto WebP conservate in documenti Firestore separati
SANTA_PHOTO_BUCKET=
# Fornito come Secret da AI Studio quando Gemini è configurato
SANTA_GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Facoltativi. Senza queste variabili si apre la ricerca pubblica Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
